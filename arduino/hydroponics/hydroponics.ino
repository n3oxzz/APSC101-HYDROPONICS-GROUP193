#define TDS_SENSOR_PIN A4

#define TDS_TARGET 1000

#define TDS_POWER_PIN 45

#define PH_SENSOR_PIN A3

#define PH_TARGET 8

#define PH_SLOPE -5.82524272
#define PH_OFFSET 12.12621359

#define LL_SENSOR_PIN 30

#define LL_DETECTED LOW

#define SENSOR_DELAY 500

namespace Sensors {

GravityTDS gravityTDS;

double tds = TDS_TARGET;
double ph = PH_TARGET;
bool ll = false;

bool flipFlop = true;
unsigned long timer = 0;

double getCurrentTDS();
double getCurrentPH();

bool isPlantWaterLow();

void init();
void update();
void stop();

}

