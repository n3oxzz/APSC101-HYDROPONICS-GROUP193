void Mixer::run () {
  motor.setSpeed(MIXING_SPED);
  motor.run(FORWARD);

  active = true;
}

bool Mixer::isActive () { 
  return active; 
}

void Mixer::init () {}
void Mixer::update () {}

void Mixer::stop () {
  motor.setSpeed(0);
  motor.run(RELEASE);

  active = false;
}

////////////////////////////////////////////////////////////////////////////////

void Nutrients::dispense () {
  startTime = millis();
  active = true;
}

bool Nutrients::isActive () { 
  return active; 
}

void Nutrients::init () {
  servo.attach(NUTRIENT_SERVO_PIN);
  servo.write(0);
}

void Nutrients::update () {
  if (millis() > startTime + NUTRIENT_IDLE_TIME) {
    startTime = millis();
    flag = false;
    return;
  }
  
  if (millis() < startTime + NUTRIENT_FILL_TIME) {
    if (flag == false) {
      servo.write(0); flag = true;
    }
    return;
  }
  if (millis() < startTime + NUTRIENT_DROP_TIME) {
    if (flag == true) {
      servo.write(180); flag = false;
    }
    return;
  }
  if (millis() < startTime + NUTRIENT_IDLE_TIME) {
    if (flag == false) {
      servo.write(0); flag = true;
    }
  }
}

void Nutrients::stop () { active = false; }

////////////////////////////////////////////////////////////////////////////////

void Ph::dispense () {
  pump.setSpeed(255);  
  pump.run(FORWARD);

  startTime = millis();
}

bool Ph::isActive () { 
  return active; 
}

void Ph::init () {}
void Ph::update () {}

void Ph::stop () {
  pump.setSpeed(0);
  pump.run(RELEASE);
}

////////////////////////////////////////////////////////////////////////////////

void Transfer::runPlant () {
  plantActive = true;

  plantPump.setSpeed(255);
  plantPump.run(FORWARD);

  startTime = millis();  
}

void Transfer::runWaste () {
  wasteActive = true;

  wastePump.setSpeed(255);
  wastePump.run(FORWARD);

  wasteTimer = millis();
}

bool Transfer::isPlantActive () { 
  return plantActive; 
}

bool Transfer::isWasteActive () { 
  return wasteActive; 
}

void Transfer::init () {}

void Transfer::update () {
  if (!Sensors::isPlantWaterLow() && plantActive) {
    plantActive = false;

    plantPump.setSpeed(0);
    plantPump.run(RELEASE);

    stopTime = millis();
  }

  unsigned long time = (stopTime - startTime) * 3.2;

  if (millis() - wasteTimer > time && wasteActive) {
    wasteActive = false;

    wastePump.setSpeed(0);
    wastePump.run(RELEASE);
    
    startTime = 0;
    stopTime = 0;
    wasteTimer = 0;
  }
}

void Transfer::stop () {  
    plantActive = false;

    plantPump.setSpeed(0);
    plantPump.run(RELEASE);

    wasteActive = false;

    wastePump.setSpeed(0);
    wastePump.run(RELEASE);

    //startTime = 0;
    stopTime = 0;
    wasteTimer = 0;
}

